# 개발 서버는 /api 요청을 이 백엔드로 전달합니다.
API_PROXY_TARGET=http://localhost:8080
# EC2 nginx 통합 배포에서는 비워 두고 같은 출처의 /api를 사용합니다.
# 별도 API origin은 서버 CORS가 구성된 경우에만 지정합니다. 마지막 /는 생략합니다.
VITE_API_BASE_URL=
# 실제 서비스 운영자 전화번호가 확정되면 입력합니다.
VITE_OPERATOR_PHONE=

# npm run check:api 전용. VITE_ 접두사가 없어 브라우저 번들에 포함되지 않습니다.
# .env.local에서 기존 주민 토큰 또는 주민 로그인 정보를 입력합니다.
VILLA_API_TOKEN=
VILLA_LOGIN_ID=
VILLA_LOGIN_PASSWORD=
# BE-10 반영 후 특정 이벤트의 상세·열람 기록을 검사할 때만 지정합니다.
VILLA_EVENT_ID=
